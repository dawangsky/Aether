{
  "name": "lottery-desktop",
  "version": "0.2.1",
  "private": true,
  "description": "双色球/大乐透量化桌面端",
  "author": "Aether <aether@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/dawangsky/Aether.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "sidecar": "bash ../scripts/build_api_sidecar.sh",
    "dist": "npm run build && electron-builder --mac",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --mac dir",
    "install:local": "npm run sidecar && npm run dist:dir && rm -rf '/Applications/LQ Terminal.app' '/Applications/AETHER · 量化.app' '/Applications/Aether.app' && cp -R 'release/mac-arm64/Aether.app' /Applications/ && xattr -cr '/Applications/Aether.app' && echo 'Installed: /Applications/Aether.app'"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  },
  "build": {
    "appId": "com.lottery.aether",
    "productName": "Aether",
    "copyright": "Copyright © Aether",
    "publish": [],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../data",
        "to": "backend/data",
        "filter": [
          "**/*.csv"
        ]
      }
    ],
    "mac": {
      "icon": "icon.icns",
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Aether ${version}"
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aether",
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    }
  }
}
